# HR VPS production profile aligned with VPS_System_Upgrade
# Copy required values into server .env (never commit real secrets)

APP_NAME=HR
APP_ENV=production
APP_DEBUG=false
APP_URL=https://hr.yourdomain.com

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dobsykjq_dms
DB_USERNAME=hr_user
DB_PASSWORD=CHANGE_ME

# This codebase uses CACHE_DRIVER (not CACHE_STORE)
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_STORE=redis
QUEUE_CONNECTION=redis
REDIS_QUEUE=default

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=CHANGE_ME
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

LOG_CHANNEL=stack
LOG_LEVEL=info
